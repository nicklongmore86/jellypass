{
  "name": "jellypass",
  "version": "0.2.0",
  "private": false,
  "description": "Personalized library access for Jellyfin.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/access-service.test.mjs test/http-integration.test.mjs",
    "test:real": "pnpm build && node --test test/real-jellyfin.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
