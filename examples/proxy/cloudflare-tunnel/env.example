# Copy to .env next to compose.yaml. Docker Compose reads it for the variable below only;
# JellyPass's own settings go in jellypass.env (or the setup wizard), never here.

# The tunnel token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker.
# A secret: anyone holding it can run your tunnel. Keep .env out of version control.
TUNNEL_TOKEN=replace-with-your-tunnel-token
# Optional: pin a JellyPass release for production.
# JELLYPASS_IMAGE=ghcr.io/nicklongmore86/jellypass:4.0.0
