# Container image used by compose.yaml. Pin a version for production.
JELLYPASS_IMAGE=ghcr.io/nicklongmore86/jellypass:latest

# Required Jellyfin connection and administrator API key.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-an-admin-api-key

# Configure both values for request-ID webhook resolution, dashboard request
# cards, Jellyseerr user import, and the optional JellyQuest bridge.
SEERR_URL=http://jellyseerr:5055
SEERR_API_KEY=replace-with-a-seerr-api-key

# Use different long random values. ADMIN_TOKEN must not reuse WEBHOOK_TOKEN.
WEBHOOK_TOKEN=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Optional passwordless JellyQuest request-session bridge on household hosts.
JELLYQUEST_BRIDGE_ENABLED=false

# Runtime and persistence. compose.yaml overrides STATE_FILE, HOST, and PORT with
# their container-safe values; these defaults also support direct Node startup.
STATE_FILE=./data/grants.json
HOST=0.0.0.0
PORT=8787
RECONCILE_INTERVAL_SECONDS=300
CATALOG_SYNC_INTERVAL_SECONDS=3600

# Optional household gateway. Existing group IDs become hostnames such as jelly-farmhouse.example.com.
HOUSEHOLD_DOMAIN=
HOUSEHOLD_HOST_PREFIX=jelly-
