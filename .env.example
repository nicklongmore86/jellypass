# Container image used by compose.yaml. Pin a version for production.
JELLYPASS_IMAGE=ghcr.io/nicklongmore86/jellypass:latest

# Required Jellyfin connection and administrator API key.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-with-an-admin-api-key

# Configure both values for request-ID webhook resolution, dashboard request
# cards, Seerr user import, and the request backfill.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=replace-with-a-seerr-api-key

# Use different long random values. ADMIN_TOKEN must not reuse WEBHOOK_TOKEN.
# Configure Seerr with Authorization: Bearer WEBHOOK_TOKEN; query-token auth is unsupported.
WEBHOOK_TOKEN=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret

# Runtime and persistence. compose.yaml overrides STATE_FILE, HOST, and PORT with
# their container-safe values; these defaults also support direct Node startup.
STATE_FILE=./data/grants.json
HOST=0.0.0.0
PORT=8787
RECONCILE_INTERVAL_SECONDS=300
CATALOG_SYNC_INTERVAL_SECONDS=3600

# Optional request backfill: grants available Seerr requests the webhook missed.
# Set REQUEST_BACKFILL_SINCE to when your Seerr webhook stopped delivering, or
# to your install date; requests created before it are never imported. Accepts
# YYYY-MM-DD (UTC midnight) or an ISO 8601 date-time with Z or an offset.
# The backfill is enabled automatically once SINCE is set and requires
# SEERR_URL and SEERR_API_KEY; JellyPass refuses to start if it is enabled
# without them, if REQUEST_BACKFILL_ENABLED=true is set without SINCE, or if
# SINCE is not a valid date. Set REQUEST_BACKFILL_ENABLED=false to pause it.
# REQUEST_BACKFILL_SINCE=2026-09-10
# REQUEST_BACKFILL_ENABLED=true

# Optional household gateway. Example household address: https://media.example.com.
HOUSEHOLD_DOMAIN=
HOUSEHOLD_HOST_PREFIX=jelly-
# Close proxied household WebSockets after this many milliseconds with no
# traffic in either direction. 0 disables. Jellyfin clients send a KeepAlive
# every 30 s, so the default (5 minutes) never cuts off a healthy client.
WS_IDLE_TIMEOUT_MS=300000
# Also close them after this many milliseconds with no traffic from Jellyfin,
# even if the client keeps sending. 0 disables. Jellyfin answers every client
# KeepAlive, so a healthy server is never silent for much more than 60 s.
WS_UPSTREAM_IDLE_TIMEOUT_MS=180000

# Optional household app (read-only; off by default): the installable app at
# /jellypass/app/ and its API at /jellypass/app/v1/* on household hostnames.
# Requires HOUSEHOLD_DOMAIN, SEERR_URL, SEERR_API_KEY and TMDB_API_KEY: a TMDB
# API key (v3) or API read access token (v4) from your TMDB account's API
# settings, which the app reads titles with. JellyPass refuses to start if the
# app is enabled without them, if TMDB refuses the key, or if TMDB_API_KEY is
# set but is not a key or token. The key is never logged. While the app is
# enabled, at most 100 households (groups) can exist: creating another is
# refused, and startup warns if the state file already holds more.
# HOUSEHOLD_APP_ENABLED=true
# TMDB_API_KEY=

# Optional TV add-on (off by default; needs HOUSEHOLD_APP_ENABLED): adds a
# JellyPass row to Jellyfin web's Home on the listed households' hostnames.
# TV_ADDON_HOUSEHOLDS is required when it is on: household IDs separated by
# commas, or * for every household. See docs/tv-addon.md.
# TV_ADDON_ENABLED=true
# TV_ADDON_HOUSEHOLDS=grove

# Reverse proxies in front of JellyPass, as comma-separated IP addresses or
# CIDR ranges (IPv4 or IPv6). Requests from these addresses are attributed to
# the client in X-Forwarded-For, so login rate limits apply per client. Leave
# empty to trust no proxy. JellyPass refuses to start on an invalid entry.
# Also add JellyPass to Jellyfin's known proxies.
TRUSTED_PROXIES=

# debug, info, warn, or error. Only debug changes output today: it also logs
# routine client disconnects and backfill requests skipped because their
# Jellyfin item was deleted. Unrecognised values fall back to info.
LOG_LEVEL=info
