{
  "description": "The household app API calls the PWA makes when each screen is opened directly, signed in: 'atOnce' when the screen opens, 'belowTheFold' once every lazy row has come near the screen (each fetched once). Sorted, as 'METHOD /path' under /jellypass/app/v1. Search is opened on one query ('{query}'); a network's page (on All, Series or Films) and a studio's page on one ID the API lists ('{id}'), first page only (Load more asks for each further page); My requests with one movie and one series request: each request shown is named with one title call, at most 'titlesAtOnce' of them before the member asks for more; shown again within ten minutes of naming them in the same sign-in, it reads the list again ('revisit') and names only the requests whose title it has not read (titles are kept in memory for ten minutes, never their state). Pinned by test/app-pwa.test.mjs ('fetch budget'). A native client makes no more calls than these for the same screen: a household's devices usually share one address and so one per-address budget. The TV add-on's Home row ('tv-home-row', docs/tv-addon.md) is pinned by test/tv-addon.test.mjs: its one call when Home is laid out, at most once a minute however often Home is redrawn or shown, and none while Home stays on screen. See docs/app-design.md, 'Native clients (contract)'.",
  "limits": {
    "perAddress": {
      "calls": 300,
      "windowSeconds": 300
    },
    "perMember": {
      "calls": 200,
      "windowSeconds": 300
    },
    "perHousehold": {
      "calls": 60,
      "windowSeconds": 10
    }
  },
  "screens": {
    "home-all": {
      "calls": 16,
      "atOnce": [
        "GET /discover/new-movies",
        "GET /discover/popular-movies",
        "GET /discover/popular-tv",
        "GET /discover/sources",
        "GET /discover/trending",
        "GET /me"
      ],
      "belowTheFold": [
        "GET /discover/network/1024/all",
        "GET /discover/network/213/all",
        "GET /discover/network/2552/all",
        "GET /discover/network/2739/all",
        "GET /discover/network/3186/all",
        "GET /discover/network/3353/all",
        "GET /discover/network/4330/all",
        "GET /discover/network/453/all",
        "GET /discover/upcoming",
        "GET /discover/upcoming-tv"
      ]
    },
    "home-movies": {
      "calls": 14,
      "atOnce": [
        "GET /discover/new-movies",
        "GET /discover/popular-movies",
        "GET /discover/sources",
        "GET /discover/trending-movies",
        "GET /discover/upcoming",
        "GET /me"
      ],
      "belowTheFold": [
        "GET /discover/network/1024/films",
        "GET /discover/network/213/films",
        "GET /discover/network/2552/films",
        "GET /discover/network/2739/films",
        "GET /discover/network/3186/films",
        "GET /discover/network/3353/films",
        "GET /discover/network/4330/films",
        "GET /discover/network/453/films"
      ]
    },
    "home-tv": {
      "calls": 13,
      "atOnce": [
        "GET /discover/popular-tv",
        "GET /discover/sources",
        "GET /discover/trending-tv",
        "GET /discover/upcoming-tv",
        "GET /me"
      ],
      "belowTheFold": [
        "GET /discover/network/1024",
        "GET /discover/network/213",
        "GET /discover/network/2552",
        "GET /discover/network/2739",
        "GET /discover/network/3186",
        "GET /discover/network/3353",
        "GET /discover/network/4330",
        "GET /discover/network/453"
      ]
    },
    "movie": {
      "calls": 3,
      "atOnce": [
        "GET /me",
        "GET /movie/{tmdbId}",
        "GET /requests"
      ]
    },
    "series": {
      "calls": 3,
      "atOnce": [
        "GET /me",
        "GET /requests",
        "GET /tv/{tmdbId}"
      ]
    },
    "season": {
      "calls": 4,
      "atOnce": [
        "GET /me",
        "GET /requests",
        "GET /tv/{tmdbId}",
        "GET /tv/{tmdbId}/season/{n}"
      ]
    },
    "search": {
      "calls": 2,
      "atOnce": [
        "GET /me",
        "GET /search?q={query}&page=1"
      ]
    },
    "requests": {
      "calls": 4,
      "titlesAtOnce": 10,
      "revisit": [
        "GET /requests"
      ],
      "atOnce": [
        "GET /me",
        "GET /movie/{tmdbId}",
        "GET /requests",
        "GET /tv/{tmdbId}"
      ]
    },
    "network": {
      "calls": 3,
      "atOnce": [
        "GET /discover/network/{id}/all",
        "GET /discover/sources",
        "GET /me"
      ]
    },
    "network-series": {
      "calls": 3,
      "atOnce": [
        "GET /discover/network/{id}",
        "GET /discover/sources",
        "GET /me"
      ]
    },
    "network-films": {
      "calls": 3,
      "atOnce": [
        "GET /discover/network/{id}/films",
        "GET /discover/sources",
        "GET /me"
      ]
    },
    "studio": {
      "calls": 3,
      "atOnce": [
        "GET /discover/sources",
        "GET /discover/studio/{id}",
        "GET /me"
      ]
    },
    "tv-home-row": {
      "calls": 1,
      "atOnce": [
        "GET /discover/trending"
      ]
    }
  }
}
