        },
        "parameters": [
          {
            "name": "list",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "trending",
                "trending-movies",
                "trending-tv",
                "popular-movies",
                "popular-tv",
                "new-movies",
                "upcoming",
                "upcoming-tv",
                "top-movies",
                "top-tv"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ]
      }
    },
