{
  "openapi": "3.1.0",
  "info": {
    "title": "JellyPass household app API",
    "version": "1",
    "description": "The household app API, /jellypass/app/v1, on household hosts only. info.version is GET /me's apiVersion. v1 only ever gains fields and endpoints; see docs/app-design.md, \"Native clients (contract)\". Schemas are closed (additionalProperties false) so the server's own test catches an undeclared field; a client decodes leniently and ignores fields it does not know. Every answer is Cache-Control: no-store."
  },
  "servers": [
    {
      "url": "https://{householdHost}/jellypass/app/v1",
      "variables": {
        "householdHost": {
          "default": "jelly-household.example.com",
          "description": "The household's own address; the household is decided from it."
        }
      }
    }
  ],
  "security": [
    {
      "jellyfinToken": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "me",
        "summary": "Who the caller is, and the API revision.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search titles.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Trimmed first; blank, or longer than 100 UTF-16 code units once trimmed, is invalid_request."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ]
      }
    },
    "/discover/{list}": {
