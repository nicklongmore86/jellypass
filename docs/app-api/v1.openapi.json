  "components": {
    "securitySchemes": {
      "jellyfinToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "MediaBrowser Token=\"<Jellyfin access token>\""
      }
    },
    "responses": {
      "Invalid": {
        "description": "400 invalid_request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InvalidRequestError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "401 unauthorized: a missing, invalid or disabled token, or a member of another household, all alike.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnauthorizedError"
            }
          }
        }
      },
      "NotFound": {
        "description": "404 not_found: an unknown path, or a title TMDB does not know. 404 household_not_found: the host is a household address no household has (no token is checked; a client signed in there treats it as the household gone).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NotFoundError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "429 too_many_requests.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TooManyRequestsError"
            }
          }
        }
      },
      "Unavailable": {
        "description": "502 unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UnavailableError"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "description": "Every error body: one of these codes, always with its own status (see the responses: InvalidRequestError, UnauthorizedError, NotFoundError, TooManyRequestsError, UnavailableError), the same for every endpoint and every title. A client treats an unknown code by its HTTP status.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "not_found",
              "household_not_found",
              "too_many_requests",
              "unavailable"
            ]
          }
        }
      },
      "InvalidRequestError": {
        "description": "400.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "const": "invalid_request"
          }
        }
      },
      "UnauthorizedError": {
        "description": "401.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "const": "unauthorized"
          }
        }
      },
      "NotFoundError": {
        "description": "404: not_found on a household host, household_not_found on a host of no household.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "not_found",
              "household_not_found"
            ]
          }
        }
      },
      "TooManyRequestsError": {
        "description": "429.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "const": "too_many_requests"
          }
        }
      },
      "UnavailableError": {
        "description": "502.",
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string",
            "const": "unavailable"
          }
        }
      },
      "HouseholdState": {
        "type": "string",
        "enum": [
          "unavailable",
          "in_library",
          "requested",
          "get_this"
        ],
        "description": "The household's own view of a title. A client renders an unknown value as unavailable."
      },
      "CoarseStatus": {
        "type": "string",
        "enum": [
          "requested",
          "ready",
          "failed"
        ],
        "description": "A household request's coarse status. A client renders an unknown value as requested."
      },
      "MediaType": {
        "type": "string",
        "enum": [
          "movie",
          "tv"
        ]
      },
      "Me": {
        "type": "object",
        "required": [
          "name",
          "household",
          "apiVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "household": {
            "type": "string"
          },
          "apiVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "The revision of the v1 contract the server speaks: one more with each release that adds a field or endpoint, never lower. Absent before it existed (revision 0)."
          }
        }
      },
      "Play": {
        "description": "Set only when state is in_library.",
        "type": "object",
        "required": [
          "itemId",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+/web/#/details\\?id=[0-9a-f]{32}$",
            "description": "Exactly https://<the household host>/web/#/details?id=<itemId>; a client ignores anything else."
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "mediaType",
          "tmdbId",
          "title",
          "year",
          "overview",
          "posterUrl",
          "backdropUrl",
          "rating",
          "state",
          "play"
        ],
        "additionalProperties": false,
        "properties": {
          "mediaType": {
            "$ref": "#/components/schemas/MediaType"
          },
          "tmdbId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Any positive whole number TMDB gives, up to 2^53 - 1; only one up to 2147483647 can be opened as /movie/{tmdbId} or /tv/{tmdbId}."
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9999
          },
          "overview": {
            "type": "string",
            "maxLength": 4000
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://image\\.tmdb\\.org/t/p/w342/[A-Za-z0-9_-]{1,100}\\.(?:jpg|jpeg|png|webp)$",
            "description": "TMDB poster at w342; the same file is served at other TMDB widths."
          },
          "backdropUrl": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://image\\.tmdb\\.org/t/p/w780/[A-Za-z0-9_-]{1,100}\\.(?:jpg|jpeg|png|webp)$",
