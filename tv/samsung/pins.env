# Every input of the JellyPass build of Jellyfin's Samsung app (tv/samsung/build-wgt.sh), pinned. Change one only on
# purpose, and check the add-on on the new Jellyfin web first (docs/tv-addon.md, "The Samsung app").

# Jellyfin web: the server's version (Jellyfin 12.3.0). Tag and the commit it must be.
JELLYFIN_WEB_REPO=https://github.com/jellyfin/jellyfin-web.git
JELLYFIN_WEB_TAG=v12.3
JELLYFIN_WEB_COMMIT=c06cb17b274c10f9015412305edb0afdc010ae7a

# jellyfin-tizen: the wrapper (config.xml with app id AprZAARz4r.Jellyfin, tizen.js, the gulp step), master (last
# commit 2025-10-24); it builds every Jellyfin web from 10.9 on (jeppevinkel/jellyfin-tizen-builds ships 12.z from it).
JELLYFIN_TIZEN_REPO=https://github.com/jellyfin/jellyfin-tizen.git
JELLYFIN_TIZEN_COMMIT=31408c121e34e73c9f50c4e201c05e95140675df

# Node for both npm builds (Jellyfin web 12.3 asks for node >= 24, npm >= 11): node:24-bookworm (24.22.1, npm 11.19.1).
NODE_IMAGE=docker.io/library/node@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a

# Tizen Studio CLI, sdb and its built-in 'dev' signing profile: the installer image the households' Jellyfin was put on
# with. Never :latest.
TIZEN_IMAGE=ghcr.io/georift/install-jellyfin-tizen@sha256:d872a8b7fdb8f9c52e8181a76d3f320fda585c0e059d65d800d2aadad27f0a66

# The app the build replaces, which config.xml must name.
TIZEN_APP_ID=AprZAARz4r.Jellyfin
